{%- comment -%} Wettercode (WMO) -> Symbol. Aufruf: {% render "cw_icon", code: 3, day: 1, size: 64 %} {%- endcomment -%}
{% template cw_icon %}{%- assign c = code | plus: 0 -%}{%- assign d = day | plus: 0 -%}
{%- case c -%}
{%- when 0 -%}{%- if d == 1 -%}{%- assign k = "sun" -%}{%- else -%}{%- assign k = "moon" -%}{%- endif -%}
{%- when 1, 2 -%}{%- if d == 1 -%}{%- assign k = "partly-day" -%}{%- else -%}{%- assign k = "partly-night" -%}{%- endif -%}
{%- when 45, 48 -%}{%- assign k = "fog" -%}
{%- when 51, 53, 55 -%}{%- assign k = "drizzle" -%}
{%- when 56, 57, 66, 67 -%}{%- assign k = "sleet" -%}
{%- when 61, 63, 65, 80, 81, 82 -%}{%- assign k = "rain" -%}
{%- when 71, 73, 75, 77, 85, 86 -%}{%- assign k = "snow" -%}
{%- when 95, 96, 99 -%}{%- assign k = "thunder" -%}
{%- else -%}{%- assign k = "cloud" -%}
{%- endcase -%}
<svg width="{{ size | default: 48 }}" height="{{ size | default: 48 }}" viewBox="0 0 48 48"><use href="#cw-{{ k }}"/></svg>
{%- endtemplate %}

{%- comment -%} Wettercode (WMO) -> deutscher Text {%- endcomment -%}
{% template cw_text %}{%- assign c = code | plus: 0 -%}{%- assign d = day | plus: 0 -%}
{%- case c -%}
{%- when 0 -%}{%- if d == 1 -%}Sonnig{%- else -%}Klar{%- endif -%}
{%- when 1 -%}{%- if d == 1 -%}Heiter{%- else -%}Überwiegend klar{%- endif -%}
{%- when 2 -%}Leicht bewölkt
{%- when 3 -%}Bedeckt
{%- when 45 -%}Nebel
{%- when 48 -%}Reifnebel
{%- when 51 -%}Leichter Niesel
{%- when 53 -%}Nieselregen
{%- when 55 -%}Starker Niesel
{%- when 56, 57 -%}Gefrierender Niesel
{%- when 61 -%}Leichter Regen
{%- when 63 -%}Mäßiger Regen
{%- when 65 -%}Starker Regen
{%- when 66, 67 -%}Gefrierender Regen
{%- when 71 -%}Leichter Schneefall
{%- when 73 -%}Schneefall
{%- when 75 -%}Starker Schneefall
{%- when 77 -%}Schneegriesel
{%- when 80 -%}Leichte Schauer
{%- when 81 -%}Regenschauer
{%- when 82 -%}Heftige Schauer
{%- when 85, 86 -%}Schneeschauer
{%- when 95 -%}Gewitter
{%- when 96, 99 -%}Gewitter mit Hagel
{%- else -%}Wechselhaft
{%- endcase -%}
{%- endtemplate %}

{%- comment -%} ===== Zeit: lokale Uhrzeit und Kalender ohne Datumsfilter (unabhängig von der Server-Zeitzone) ===== {%- endcomment -%}
{%- assign cw_wochentage = "Sonntag,Montag,Dienstag,Mittwoch,Donnerstag,Freitag,Samstag" | split: "," -%}
{%- assign cw_wt_kurz = "So,Mo,Di,Mi,Do,Fr,Sa" | split: "," -%}
{%- assign cw_monate = "Januar,Februar,März,April,Mai,Juni,Juli,August,September,Oktober,November,Dezember" | split: "," -%}
{%- assign cw_wetter = IDX_0 -%}
{%- assign cw_off = cw_wetter.utc_offset_seconds | default: trmnl.user.utc_offset | default: 0 | plus: 0 -%}
{%- assign cw_now = trmnl.system.timestamp_utc | plus: cw_off -%}
{%- assign cw_now_min = cw_now | modulo: 86400 | divided_by: 60 -%}
{%- assign cw_h = cw_now_min | divided_by: 60 -%}
{%- assign cw_m = cw_now_min | modulo: 60 -%}
{%- capture cw_uhr -%}{% if cw_h < 10 %}0{% endif %}{{ cw_h }}:{% if cw_m < 10 %}0{% endif %}{{ cw_m }}{%- endcapture -%}
{%- assign cw_tag0 = cw_now | divided_by: 86400 -%}
{%- assign cw_wt = cw_tag0 | plus: 4 | modulo: 7 -%}
{%- comment -%} Datum aus Tagesnummer (Algorithmus "civil_from_days") {%- endcomment -%}
{%- assign z = cw_tag0 | plus: 719468 -%}{%- assign era = z | divided_by: 146097 -%}{%- assign doe = era | times: -146097 | plus: z -%}
{%- assign a1 = doe | divided_by: 1460 -%}{%- assign a2 = doe | divided_by: 36524 -%}{%- assign a3 = doe | divided_by: 146096 -%}
{%- assign yoe = doe | minus: a1 | plus: a2 | minus: a3 | divided_by: 365 -%}
{%- assign b1 = yoe | times: 365 -%}{%- assign b2 = yoe | divided_by: 4 -%}{%- assign b3 = yoe | divided_by: 100 -%}
{%- assign doy = doe | minus: b1 | minus: b2 | plus: b3 -%}
{%- assign mp = doy | times: 5 | plus: 2 | divided_by: 153 -%}
{%- assign cw_tag = mp | times: 153 | plus: 2 | divided_by: 5 | times: -1 | plus: doy | plus: 1 -%}
{%- if mp < 10 -%}{%- assign cw_monat = mp | plus: 3 -%}{%- else -%}{%- assign cw_monat = mp | minus: 9 -%}{%- endif -%}
{%- assign cw_jahr = era | times: 400 | plus: yoe -%}{%- if cw_monat <= 2 -%}{%- assign cw_jahr = cw_jahr | plus: 1 -%}{%- endif -%}
{%- assign mi = cw_monat | minus: 1 -%}
{%- capture cw_datum_lang -%}{{ cw_wochentage[cw_wt] }}, {{ cw_tag }}. {{ cw_monate[mi] }}{%- endcapture -%}
