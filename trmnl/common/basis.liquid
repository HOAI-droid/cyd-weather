{%- comment -%}
  Gemeinsame Grundlage aller Seiten: Schrift, Stil fürs E-Ink (nur Schwarz/Weiß),
  gezeichnete Symbole und kleine Bausteine für Wettercodes.
  Wird beim Bauen vor die Logik der jeweiligen Seite gesetzt (shared.liquid).
{%- endcomment -%}
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700;800&display=block">
<style>
  .cw, .cw * { box-sizing: border-box; margin: 0; padding: 0; }
  .cw { position: relative; width: 100%; height: 100%; overflow: hidden; background: #fff; color: #000;
        font-family: "Outfit", "Inter", "Helvetica Neue", Arial, sans-serif; font-weight: 500; line-height: 1.15;
        -webkit-font-smoothing: none; font-smooth: never; }
  .cw svg { display: block; }
  /* Symbole: Farbe über "color" (currentColor), Füllfläche über --cw-bg – wirkt auch in <use>-Kopien */
  .cw-ico { fill: none; stroke: currentColor; stroke-width: 3; stroke-linecap: round; stroke-linejoin: round; }
  .cw-fill { fill: currentColor; stroke: currentColor; }
  .cw-bgfill { fill: var(--cw-bg, #fff); }
  .cw .row { display: flex; align-items: center; }
  .cw .col { display: flex; flex-direction: column; }
  .cw .grow { flex: 1 1 auto; min-width: 0; }
  .cw .ell { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .cw .b { font-weight: 700; }
  .cw .xb { font-weight: 800; }
  .cw .num { font-variant-numeric: tabular-nums; }
  .cw .lbl { font-size: 15px; font-weight: 600; letter-spacing: .08em; text-transform: uppercase; }
  .cw .inv { background: #000; color: #fff; --cw-bg: #000; }
  .cw .rule { border-top: 2px solid #000; }
  .cw .hair { border-top: 1px solid #000; }
  .cw .badge { display: inline-flex; align-items: center; justify-content: center; background: #000; color: #fff;
               font-weight: 800; border-radius: 6px; padding: 0 6px; }
  .cw .badge.out { background: #fff; color: #000; border: 2px solid #000; }
  .cw .strike { text-decoration: line-through; text-decoration-thickness: 2px; }
  .cw .dots { background-image: radial-gradient(#000 1px, transparent 1.2px); background-size: 4px 4px; }
</style>
<svg width="0" height="0" style="position:absolute;color:#000" aria-hidden="true">
  <defs>
