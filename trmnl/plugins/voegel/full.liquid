<div class="view view--full">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=EB+Garamond:ital,wght@0,400;0,500;1,400&family=IM+Fell+English:ital@0;1&family=IM+Fell+English+SC&display=block">
<style>
  .vg { font-family: "EB Garamond", Georgia, serif; }
  .vg .sc { font-family: "IM Fell English SC", "IM Fell English", Georgia, serif; }
  .vg .bild { position: absolute; left: 0; top: 0; bottom: 0; width: 430px; display: flex; align-items: center; justify-content: center; }
  .vg .bild img { max-width: 100%; max-height: 100%; display: block; }
  .vg .rechts { position: absolute; left: 452px; top: 0; right: 0; bottom: 0; display: flex; flex-direction: column; }
  .vg .kopf { font-size: 13px; letter-spacing: .16em; border-bottom: 1px solid #000; padding-bottom: 4px; white-space: nowrap; }
  .vg h1 { font-weight: 500; font-size: 40px; line-height: 1.05; margin-top: 12px; }
  .vg .lat { font-family: "IM Fell English", serif; font-style: italic; font-size: 19px; margin-bottom: 10px; }
  .vg .fam { font-size: 15px; border-top: 1px solid #000; border-bottom: 1px solid #000; padding: 3px 0; }
  .vg .text { font-size: 16px; line-height: 1.26; margin-top: 10px; display: -webkit-box; -webkit-line-clamp: 9; -webkit-box-orient: vertical; overflow: hidden; }
  .vg .quelle { margin-top: auto; font-family: "IM Fell English", serif; font-size: 12px; font-style: italic; border-top: 1px solid #000; padding-top: 4px; }
  .vg .leer { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; font-size: 20px; text-align: center; }
</style>
<div class="cw vg">
  {%- if tb_n == 0 -%}<div class="leer">Die Vogelbilder sind noch nicht erzeugt<br>oder die Liste ist nicht erreichbar.</div>
  {%- else -%}
  <div class="bild"><img src="{{ tb.bild }}" alt=""></div>
  <div class="rechts">
    <div class="kopf sc">Vogel des Tages · {{ tb_tag }}</div>
    <h1>{{ tb.titel }}</h1>
    {%- if tb.latein != blank -%}<div class="lat">{{ tb.latein }}</div>{%- endif -%}
    {%- if tb.familie != blank -%}<div class="fam">{{ tb.familie }}</div>{%- endif -%}
    {%- if tb.text != blank -%}<div class="text">{{ tb.text }}</div>{%- endif -%}
    <div class="quelle">{{ tb.zeile }}</div>
  </div>
  {%- endif -%}
</div>
</div>
