<div class="view view--full">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=IM+Fell+English:ital@0;1&family=IM+Fell+English+SC&display=block">
<style>
  .tb { display: flex; flex-direction: column; font-family: "IM Fell English", Georgia, serif; }
  .tb .sc { font-family: "IM Fell English SC", "IM Fell English", Georgia, serif; }
  .tb .bild { flex: 1 1 auto; min-height: 0; display: flex; align-items: center; justify-content: center; }
  .tb .bild img { max-width: 100%; max-height: 100%; display: block; }
  .tb .zeile { flex-shrink: 0; display: flex; align-items: baseline; justify-content: space-between; gap: 16px; border-top: 1px solid #000; margin-top: 6px; padding-top: 4px; }
  .tb .zeile .t { font-size: 20px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .tb .zeile .t i { font-size: 17px; }
  .tb .zeile .n { font-size: 13px; letter-spacing: .14em; white-space: nowrap; }
  .tb .text { flex-shrink: 0; font-size: 15px; font-style: italic; line-height: 1.2; margin-top: 2px; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  .tb .leer { flex: 1; display: flex; align-items: center; justify-content: center; font-size: 20px; text-align: center; }
</style>
<div class="cw tb">
  {%- if tb_n == 0 -%}<div class="leer">Die Bilder sind noch nicht erzeugt<br>oder die Liste ist nicht erreichbar.</div>
  {%- else -%}
  <div class="bild"><img src="{{ tb.bild }}" alt=""></div>
  <div class="zeile"><span class="t">{{ tb.titel }}{% if tb.zeile != blank %} <i>· {{ tb.zeile }}</i>{% endif %}</span><span class="n sc">{{ cf.kopf | default: "Tafel" }} {{ tb_tag }}</span></div>
  {%- if tb.text != blank and cf.text != "nein" -%}<div class="text">{{ tb.text }}</div>{%- endif -%}
  {%- endif -%}
</div>
</div>
