<div class="view view--full">
<style>
  .abf { display: flex; flex-direction: column; }
  .abf .kopf { height: 44px; padding: 0 18px; justify-content: space-between; border-bottom: 3px solid #000; }
  .abf .kopf .datum { font-size: 23px; font-weight: 700; }
  .abf .kopf .stand { font-size: 16px; }
  .abf .mitte { flex: 1 1 auto; display: flex; min-height: 0; }
  .abf .fahrt { width: 400px; padding: 10px 14px 6px 18px; display: flex; flex-direction: column; }
  .abf .wetter { width: 400px; border-left: 3px solid #000; padding: 8px 16px 6px 16px; display: flex; flex-direction: column; }
  .abf .titel { gap: 6px; margin-bottom: 7px; }
  .abf .zeile { height: 31px; font-size: 18px; }
  .abf .zeile .badge { font-size: 15px; height: 22px; min-width: 28px; }
  .abf .fehler { font-size: 17px; padding: 12px 2px; }
  .abf .jetzt { gap: 10px; }
  .abf .jetzt .t { font-size: 66px; font-weight: 500; line-height: .95; letter-spacing: -2px; }
  .abf .jetzt .hl { align-items: flex-end; font-size: 18px; gap: 1px; }
  .abf .jetzt .hl .gf { font-size: 14px; margin-top: 2px; }
  .abf .txt { font-size: 22px; font-weight: 700; text-align: center; margin-top: 2px; }
  .abf .spruch { font-size: 15px; font-style: italic; text-align: center; margin-top: 1px; }
  .abf .kacheln { gap: 7px; margin-top: 9px; }
  .abf .kachel { flex: 1 1 0; align-items: center; gap: 1px; padding: 5px 2px 4px; border: 2px solid #000; border-radius: 9px; font-size: 13px; }
  .abf .kachel b { font-size: 17px; }
  .abf .vl { font-size: 12px; margin-top: auto; padding-top: 4px; }
  .abf .verlauf { justify-content: space-between; padding-top: 3px; }
  .abf .verlauf .col { align-items: center; width: 16.6%; }
  .abf .verlauf .h { font-size: 13px; font-weight: 600; }
  .abf .verlauf .tt { font-weight: 700; font-size: 18px; }
  .abf .verlauf .pp { font-size: 12px; height: 14px; }
  .abf .muell { height: 72px; border-top: 3px solid #000; display: flex; }
  .abf .muell .termin { flex: 1 1 0; gap: 10px; padding: 0 14px; border-left: 2px solid #000; min-width: 0; }
  .abf .muell .termin:first-child { border-left: 0; padding-left: 18px; }
  .abf .muell .wann { font-size: 15px; font-weight: 600; }
  .abf .muell .was { font-size: 19px; font-weight: 800; line-height: 1.05; }
  .abf .muell .hinweis { font-size: 16px; padding: 0 18px; gap: 10px; }

  /* ===== Schriftgröße "groß": weniger Abfahrten, große Zahlen, aus der Ferne lesbar ===== */
  .abf.gross .kopf { height: 48px; }
  .abf.gross .kopf .datum { font-size: 27px; }
  .abf.gross .kopf .stand { font-size: 18px; }
  .abf.gross .titel { margin-bottom: 4px; }
  .abf.gross .titel .lbl { font-size: 15px !important; }
  .abf.gross .abl .zeile { height: 52px; font-size: 27px; gap: 10px; }
  .abf.gross .abl .zeile .badge { font-size: 23px; height: 36px; min-width: 42px; border-radius: 8px; }
  .abf.gross .abl .zeile.erste { font-size: 29px; height: 58px; }
  .abf.gross .abl .zeile.erste .badge { font-size: 27px; height: 42px; min-width: 48px; }
  .abf.gross .abl .zeile .st { font-size: 20px; }
  .abf.gross .fehler { font-size: 21px; }
  .abf.gross .wetter > * { flex-shrink: 0; }
  .abf.gross .jetzt .t { font-size: 92px; font-weight: 600; letter-spacing: -4px; }
  .abf.gross .jetzt .hl { font-size: 27px; }
  .abf.gross .jetzt .hl .gf { font-size: 17px; }
  .abf.gross .txt { font-size: 27px; }
  .abf.gross .kacheln { margin-top: 7px; gap: 6px; }
  .abf.gross .kachel { font-size: 13px; padding: 3px 2px; }
  .abf.gross .kachel b { font-size: 21px; white-space: nowrap; letter-spacing: -.5px; }
  .abf.gross .vl { font-size: 14px; }
  .abf.gross .verlauf .col { width: 25%; }
  .abf.gross .verlauf .h { font-size: 17px; }
  .abf.gross .verlauf .tt { font-size: 30px; font-weight: 800; line-height: 1; }
  .abf.gross .verlauf .pp { font-size: 14px; height: 16px; }
  .abf.gross .muell { height: 84px; }
  .abf.gross .muell .wann { font-size: 17px; }
  .abf.gross .muell .was { font-size: 22px; white-space: normal; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; }
</style>
{%- if cw_gross -%}
  {%- assign max_abf = 5 -%}{%- assign vl_n = 3 -%}{%- assign ico_jetzt = 72 -%}{%- assign ico_vl = 42 -%}{%- assign ico_k = 22 -%}
{%- else -%}
  {%- assign max_abf = 9 -%}{%- assign vl_n = 5 -%}{%- assign ico_jetzt = 80 -%}{%- assign ico_vl = 40 -%}{%- assign ico_k = 22 -%}
{%- endif -%}
<div class="cw abf{% if cw_gross %} gross{% endif %}">
  <div class="row kopf">
    <div class="datum">{{ cw_datum_lang }}</div>
    <div class="stand">{{ cf.ort }} · Stand {{ cw_uhr }} Uhr</div>
  </div>

  <div class="mitte">
    <div class="fahrt">
      <div class="row titel"><svg width="18" height="18"><use href="#cw-bus"/></svg>
        <span class="lbl ell" style="font-size:13px">{{ cw_halt_name }}{% if cf.richtung != blank %} → {{ cf.richtung }}{% endif %}</span></div>

      {%- if cw_abf_fehler != "" -%}<div class="fehler"><b>Abfahrten nicht verfügbar.</b><br>{{ cw_abf_fehler }}</div>
      {%- elsif cw_abf_n == 0 -%}<div class="fehler"><b>Keine Abfahrten</b> in den nächsten 3 Stunden.</div>
      {%- else -%}{% render "cw_abf_liste", liste: cw_abf, max: max_abf %}{%- endif -%}
    </div>

    <div class="wetter">
      {%- if cw_w_ok -%}
      <div class="row jetzt">
        {% render "cw_icon", code: cw_code, day: cw_day, size: ico_jetzt %}
        <div class="t num grow">{{ cw_temp }}°</div>
        <div class="col hl num">
          <span>▲ <b>{{ cw_max }}°</b></span>
          <span>▼ <b>{{ cw_min }}°</b></span>
          <span class="gf">Gefühlt {{ cw_gefuehlt }}°</span>
        </div>
      </div>
      <div class="txt ell">{% render "cw_text", code: cw_code, day: cw_day %}</div>
      {%- unless cw_gross -%}<div class="spruch ell">{% if cw_spruch != "" %}„{{ cw_spruch }}“{% else %}{{ cw_regen }}{% endif %}</div>{%- endunless -%}

      <div class="row kacheln">
        <div class="col kachel"><svg width="{{ ico_k }}" height="{{ ico_k }}"><use href="#cw-drop"/></svg><b class="num">{{ cw_feuchte }} %</b><span>Feuchte</span></div>
        <div class="col kachel"><svg width="{{ ico_k }}" height="{{ ico_k }}"><use href="#cw-wind"/></svg><b class="num">{{ cw_wind }} km/h</b><span>Wind</span></div>
        <div class="col kachel"><svg width="{{ ico_k }}" height="{{ ico_k }}"><use href="#cw-umbrella"/></svg><b class="num">{{ cw_pop }} %</b><span>Regen</span></div>
        <div class="col kachel"><svg width="{{ ico_k }}" height="{{ ico_k }}"><use href="#cw-uv"/></svg><b class="num">{{ cw_uv }}</b><span>UV</span></div>
      </div>

      {%- comment -%} Tagesverlauf: jetzt und dann alle 3 Stunden (stündliche Werte beginnen um 00:00 heute) {%- endcomment -%}
      <div class="lbl vl">Tagesverlauf</div>
      <div class="row verlauf">
        {%- for k in (0..vl_n) -%}{%- assign i = k | times: 3 | plus: cw_h -%}{%- assign pp = cw_wetter.hourly.precipitation_probability[i] | default: 0 -%}
        <div class="col">
          <span class="h">{% if k == 0 %}Jetzt{% else %}{{ cw_wetter.hourly.time[i] | slice: 11, 2 }} Uhr{% endif %}</span>
          {% render "cw_icon", code: cw_wetter.hourly.weather_code[i], day: cw_wetter.hourly.is_day[i], size: ico_vl %}
          <span class="tt num">{{ cw_wetter.hourly.temperature_2m[i] | round }}°</span>
          <span class="pp num">{% if pp >= 20 %}{{ pp }} %{% endif %}</span>
        </div>
        {%- endfor -%}
      </div>
      {%- else -%}
        <div class="fehler"><b>Wetter nicht verfügbar.</b><br>Open-Meteo antwortet nicht.</div>
      {%- endif -%}
    </div>
  </div>

  {%- comment -%} Müll-Leiste: immer die nächsten 3 Termine. Ab der Erinnerungszeit am Vorabend wird der Termin von morgen schwarz. {%- endcomment -%}
  {%- if cw_muell_aktiv -%}
  <div class="muell">
    {%- if cw_muell_fehler != "" -%}
      <div class="row hinweis"><svg width="30" height="30"><use href="#cw-bin"/></svg><span>{{ cw_muell_fehler }}</span></div>
    {%- elsif cw_muell_n == 0 -%}
      <div class="row hinweis"><svg width="30" height="30"><use href="#cw-bin"/></svg><span>Keine Abholung in den nächsten 5 Wochen.</span></div>
    {%- else -%}
      {%- for e in cw_muell limit: 3 -%}{%- assign f = e | split: "^" -%}
        {%- assign hell = false -%}
        {%- if f[0] == "1" and cw_muell_alarm == "abend" -%}{%- assign hell = true -%}{%- endif -%}
        {%- if f[0] == "0" and cw_muell_alarm == "morgen" -%}{%- assign hell = true -%}{%- endif -%}
        <div class="row termin{% if hell %} inv{% endif %}">
          <svg width="34" height="34"><use href="#cw-{% if hell %}bell{% elsif f[2] == 'Bio' %}leaf{% else %}bin{% endif %}"/></svg>
          <div class="col grow">
            <span class="wann">{% if f[0] == "0" %}{% if hell %}Heute Abholung!{% else %}Heute{% endif %}{% elsif f[0] == "1" %}{% if hell %}Heute Abend raus!{% else %}Morgen{% endif %}{% else %}{{ f[1] }}{% endif %}</span>
            <span class="was ell">{{ f[2] }}</span>
          </div>
        </div>
      {%- endfor -%}
    {%- endif -%}
  </div>
  {%- endif -%}
</div>
</div>
