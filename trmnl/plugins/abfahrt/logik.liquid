{%- comment -%}
  Seite 1 – Daten aufbereiten. Ergebnis sind cw_*-Variablen, die alle Layouts nutzen.
  IDX_0 = Open-Meteo, IDX_1 = Abfahrten (RMV-API oder dbf.finalrewind.org), IDX_2 = EAD-Müllkalender
{%- endcomment -%}
{%- assign cf = trmnl.plugin_settings.custom_fields_values -%}
{%- assign cw_ort_prefix = cf.ort | append: " " -%}
{%- assign cw_ort_suffix = cf.ort | prepend: ", " -%}
{%- assign cw_ort_bind = cf.ort | append: "-" -%}

{%- comment -%}
  ===== Abfahrten =====
  Zwei mögliche Quellen, beide werden auf dasselbe Format gebracht:
  - mit RMV-API-Schlüssel: offizielle RMV-Schnittstelle (HAFAS ReST, "Departure"-Liste, passlist=1 für die Richtung)
  - ohne Schlüssel: dbf.finalrewind.org ("departures"-Liste, Richtung filtert der Dienst selbst)
  Eintrag je Fahrt: Minuten bis Abfahrt ^ Abfahrt HH:MM ^ Linie ^ Ziel ^ Verspätung ^ Ausfall (1/0) ^ Plan HH:MM
{%- endcomment -%}
{%- assign abf = IDX_1 -%}
{%- assign cw_api = false -%}{%- if cf.rmv_key != blank -%}{%- assign cw_api = true -%}{%- endif -%}
{%- assign richtung = cf.richtung | strip | downcase -%}
{%- assign cw_abf_fehler = "" -%}
{%- if abf == nil or abf.error or abf.errorCode -%}
  {%- assign cw_abf_fehler = abf.errorText | default: abf.error | default: "Keine Daten" -%}
  {%- if cw_abf_fehler contains "ambiguous" -%}{%- assign cw_abf_fehler = "Haltestelle mehrdeutig – Namen genauer angeben" -%}{%- endif -%}
  {%- if cw_abf_fehler contains "LOCATION" -%}{%- assign cw_abf_fehler = "Haltestelle beim RMV nicht gefunden. Namen genau in RMV-Schreibweise (z. B. „Darmstadt-Arheilgen …“) oder mit RMV-Schlüssel die Haltestellen-Nummer eintragen." -%}{%- endif -%}
  {%- if cw_abf_fehler contains "Failed to fetch" -%}
    {%- if cw_api -%}{%- assign cw_abf_fehler = "RMV antwortet nicht. API-Schlüssel und Haltestellen-Nummer prüfen." -%}{%- else -%}{%- assign cw_abf_fehler = "Fahrplan nicht erreichbar" -%}{%- endif -%}
  {%- endif -%}
{%- endif -%}
{%- if cw_api -%}{%- assign fahrten = abf.Departure -%}{%- else -%}{%- assign fahrten = abf.departures -%}{%- endif -%}
{%- comment -%} Anzeigename der Haltestelle: bei Nummern aus der Antwort nehmen {%- endcomment -%}
{%- assign cw_halt_name = cf.haltestelle | remove: cw_ort_suffix | remove_first: cw_ort_prefix | remove_first: cw_ort_bind -%}
{%- if cw_api and fahrten[0].stop -%}{%- assign cw_halt_name = fahrten[0].stop | remove_first: cw_ort_prefix | remove_first: cw_ort_bind -%}{%- endif -%}
{%- capture abf_liste -%}
{%- for d in fahrten -%}
  {%- if cw_api -%}
    {%- comment -%} Richtung: fährt die Fahrt nach unserer Haltestelle über die gesuchte? {%- endcomment -%}
    {%- if richtung != "" -%}
      {%- assign hier = false -%}{%- assign treffer = false -%}{%- assign gefunden_hier = false -%}
      {%- for st in d.Stops.Stop -%}{%- if st.extId == d.stopExtId -%}{%- assign gefunden_hier = true -%}{%- endif -%}{%- endfor -%}
      {%- unless gefunden_hier -%}{%- assign hier = true -%}{%- endunless -%}
      {%- for st in d.Stops.Stop -%}
        {%- if hier -%}{%- assign sn = st.name | downcase -%}{%- if sn contains richtung -%}{%- assign treffer = true -%}{%- break -%}{%- endif -%}{%- endif -%}
        {%- if st.extId == d.stopExtId -%}{%- assign hier = true -%}{%- endif -%}
      {%- endfor -%}
      {%- unless treffer -%}{%- continue -%}{%- endunless -%}
    {%- endif -%}
    {%- assign plan = d.time | slice: 0, 5 -%}
    {%- assign t = d.rtTime | default: d.time | slice: 0, 5 -%}
    {%- assign linie = d.ProductAtStop.line | default: d.ProductAtStop.displayNumber | default: d.name | default: "?" -%}
    {%- assign ziel = d.direction | default: "?" -%}
    {%- assign ausfall = 0 -%}{%- if d.cancelled == true or d.cancelled == "true" -%}{%- assign ausfall = 1 -%}{%- endif -%}
  {%- else -%}
    {%- assign t = d.time | default: d.departure | default: d.sched_departure -%}
    {%- assign plan = d.sched_departure | default: t -%}
    {%- assign linie = d.train_line | default: d.train | default: "?" -%}
    {%- assign ziel = d.destination | default: "?" -%}
    {%- assign ausfall = 0 -%}{%- if d.is_cancelled == 1 or d.is_cancelled == true -%}{%- assign ausfall = 1 -%}{%- endif -%}
  {%- endif -%}
  {%- if t == nil or t == "" -%}{%- continue -%}{%- endif -%}
  {%- assign tp = t | split: ":" -%}{%- assign dm = tp[0] | plus: 0 | times: 60 | plus: tp[1] -%}
  {%- assign pp = plan | split: ":" -%}{%- assign pm = pp[0] | plus: 0 | times: 60 | plus: pp[1] -%}
  {%- assign vsp = dm | minus: pm -%}{%- if vsp < -720 -%}{%- assign vsp = vsp | plus: 1440 -%}{%- endif -%}{%- if vsp > 720 -%}{%- assign vsp = vsp | minus: 1440 -%}{%- endif -%}
  {%- assign diff = dm | minus: cw_now_min -%}
  {%- if diff < -720 -%}{%- assign diff = diff | plus: 1440 -%}{%- endif -%}
  {%- if diff < 0 -%}{%- continue -%}{%- endif -%}
  {%- assign linie = linie | remove: "Bus " | remove: "Tram " | remove: "STR " | strip -%}
  {%- assign ziel = ziel | remove_first: cw_ort_prefix | remove_first: cw_ort_bind | remove: cw_ort_suffix | strip -%}
  {{ diff }}^{{ t }}^{{ linie }}^{{ ziel | replace: "^", " " | replace: "~", " " }}^{{ vsp }}^{{ ausfall }}^{{ plan }}~
{%- endfor -%}
{%- endcapture -%}
{%- assign cw_abf = abf_liste | strip | split: "~" -%}
{%- assign cw_abf_n = 0 -%}{%- if abf_liste != blank -%}{%- assign cw_abf_n = cw_abf.size -%}{%- endif -%}

{%- comment -%} ===== Wetter heute ===== {%- endcomment -%}
{%- assign cw_w_ok = false -%}{%- if cw_wetter.current -%}{%- assign cw_w_ok = true -%}{%- endif -%}
{%- assign cw_temp = cw_wetter.current.temperature_2m | round -%}
{%- assign cw_gefuehlt = cw_wetter.current.apparent_temperature | round -%}
{%- assign cw_code = cw_wetter.current.weather_code | default: 3 -%}
{%- assign cw_day = cw_wetter.current.is_day | default: 1 -%}
{%- assign cw_max = cw_wetter.daily.temperature_2m_max[0] | round -%}
{%- assign cw_min = cw_wetter.daily.temperature_2m_min[0] | round -%}
{%- assign cw_pop = cw_wetter.daily.precipitation_probability_max[0] | default: 0 -%}
{%- assign cw_wind = cw_wetter.current.wind_speed_10m | round -%}
{%- assign cw_auf = cw_wetter.daily.sunrise[0] | slice: 11, 5 -%}
{%- assign cw_unter = cw_wetter.daily.sunset[0] | slice: 11, 5 -%}

{%- assign cw_feuchte = cw_wetter.current.relative_humidity_2m | round -%}
{%- assign cw_uv = cw_wetter.daily.uv_index_max[0] | default: 0 | round -%}
{%- comment -%} Regen in den nächsten 2 Stunden (15-Minuten-Werte) {%- endcomment -%}
{%- assign cw_regen = "" -%}{%- assign regen_jetzt = false -%}
{%- for p in cw_wetter.minutely_15.precipitation -%}
  {%- if p >= 0.1 -%}
    {%- if forloop.first -%}{%- assign regen_jetzt = true -%}{%- else -%}{%- unless regen_jetzt -%}{%- assign rz = cw_wetter.minutely_15.time[forloop.index0] | slice: 11, 5 -%}{%- assign cw_regen = "Regen ab " | append: rz -%}{%- break -%}{%- endunless -%}{%- endif -%}
  {%- elsif regen_jetzt -%}
    {%- assign rz = cw_wetter.minutely_15.time[forloop.index0] | slice: 11, 5 -%}{%- assign cw_regen = "Regen bis etwa " | append: rz -%}{%- break -%}
  {%- endif -%}
{%- endfor -%}
{%- if cw_regen == "" -%}{%- if regen_jetzt -%}{%- assign cw_regen = "Regen in den nächsten 2 Std." -%}{%- else -%}{%- assign cw_regen = "Trocken in den nächsten 2 Std." -%}{%- endif -%}{%- endif -%}

{%- comment -%} ===== Müll (EAD Darmstadt: {"28.10.2026": ["RM1","BIO"], ...}) ===== {%- endcomment -%}
{%- assign muell = IDX_2 -%}
{%- assign cw_muell_aktiv = false -%}{%- if cf.strasse != blank -%}{%- assign cw_muell_aktiv = true -%}{%- endif -%}
{%- assign cw_muell_fehler = "" -%}
{%- if cw_muell_aktiv -%}
  {%- if muell == nil or muell.error -%}{%- assign cw_muell_fehler = "Müllkalender nicht erreichbar" -%}
  {%- elsif muell.data -%}{%- assign cw_muell_fehler = "Straße im EAD-Kalender nicht gefunden" -%}{%- endif -%}
{%- endif -%}
{%- assign ml = "31,28,31,30,31,30,31,31,30,31,30,31" | split: "," -%}
{%- assign dd = cw_tag -%}{%- assign mm = cw_monat -%}{%- assign yy = cw_jahr -%}
{%- assign cw_muell_heute = "" -%}{%- assign cw_muell_morgen = "" -%}
{%- capture muell_liste -%}
{%- for i in (0..34) -%}
  {%- capture key -%}{% if dd < 10 %}0{% endif %}{{ dd }}.{% if mm < 10 %}0{% endif %}{{ mm }}.{{ yy }}{%- endcapture -%}
  {%- assign arten = muell[key] -%}
  {%- if arten and arten.size > 0 -%}
    {%- capture namen -%}{%- for a in arten -%}{%- case a -%}{%- when "RM1", "RM2", "RM4", "RM" -%}Restmüll{%- when "WET", "GS", "GT" -%}Gelbe Tonne{%- when "BIO" -%}Bio{%- when "PPK", "PAP" -%}Papier{%- else -%}{{ a }}{%- endcase -%}{%- unless forloop.last -%}{{ " + " }}{%- endunless -%}{%- endfor -%}{%- endcapture -%}
    {%- if i == 0 -%}{%- assign cw_muell_heute = namen -%}{%- endif -%}
    {%- if i == 1 -%}{%- assign cw_muell_morgen = namen -%}{%- endif -%}
    {%- assign wi = cw_wt | plus: i | modulo: 7 -%}
    {{ i }}^{{ cw_wt_kurz[wi] }} {{ dd }}.{{ mm }}.^{{ namen }}~
  {%- endif -%}
  {%- comment -%} nächster Tag {%- endcomment -%}
  {%- assign mi2 = mm | minus: 1 -%}{%- assign mlen = ml[mi2] | plus: 0 -%}
  {%- if mm == 2 -%}{%- assign r4 = yy | modulo: 4 -%}{%- assign r100 = yy | modulo: 100 -%}{%- assign r400 = yy | modulo: 400 -%}
    {%- if r4 == 0 and r100 != 0 or r400 == 0 -%}{%- assign mlen = 29 -%}{%- endif -%}{%- endif -%}
  {%- assign dd = dd | plus: 1 -%}
  {%- if dd > mlen -%}{%- assign dd = 1 -%}{%- assign mm = mm | plus: 1 -%}{%- if mm > 12 -%}{%- assign mm = 1 -%}{%- assign yy = yy | plus: 1 -%}{%- endif -%}{%- endif -%}
{%- endfor -%}
{%- endcapture -%}
{%- assign cw_muell = muell_liste | strip | split: "~" -%}{%- assign cw_muell_n = cw_muell.size -%}{%- if muell_liste == blank -%}{%- assign cw_muell_n = 0 -%}{%- endif -%}
{%- assign erinnerung = cf.erinnerung | default: 17 | plus: 0 -%}
{%- assign cw_muell_alarm = "" -%}
{%- if cw_muell_morgen != "" and cw_h >= erinnerung -%}{%- assign cw_muell_alarm = "abend" -%}
{%- elsif cw_muell_heute != "" and cw_h < 10 -%}{%- assign cw_muell_alarm = "morgen" -%}{%- endif -%}

{%- comment -%} Abfahrtsliste. Aufruf: {% render "cw_abf_liste", liste: cw_abf, max: 8 %} {%- endcomment -%}
<style>
  .cw .abl .zeile { gap: 8px; border-top: 1px solid #000; }
  .cw .abl .zeile:first-child { border-top: 0; }
  .cw .abl .zeile .uhr { width: auto; min-width: 3em; text-align: right; font-weight: 800; }
  .cw .abl .zeile .st { font-size: .8em; }
  .cw .abl .zeile.aus .ziel, .cw .abl .zeile.aus .uhr { text-decoration: line-through; text-decoration-thickness: 2px; }
  .cw .abl .zeile.aus .badge { background: #fff; color: #000; border: 2px solid #000; }
  .cw .abl .zeile.erste { font-size: 1.3em; height: 1.9em; }
  .cw .abl .zeile.erste .badge { font-size: 1em; height: 1.45em; min-width: 1.8em; }
</style>
{% template cw_abf_liste %}
<div class="abl">
{%- assign n = 0 -%}
{%- for e in liste -%}{%- if e == "" -%}{%- continue -%}{%- endif -%}{%- assign f = e | split: "^" -%}{%- assign vsp = f[4] | default: "0" | plus: 0 -%}
  <div class="row zeile{% if f[5] == '1' %} aus{% endif %}{% if n == 0 %} erste{% endif %}">
    <span class="badge">{{ f[2] }}</span>
    <span class="ziel grow ell">{{ f[3] }}</span>
    {%- if f[5] == "1" -%}<span class="st b">fällt aus</span>
    {%- elsif vsp > 0 -%}<span class="st b">+{{ vsp }}</span>
    {%- elsif vsp < 0 -%}<span class="st b">{{ vsp }}</span>{%- endif -%}
    <span class="uhr num">{% if f[5] == "1" %}{{ f[6] }}{% else %}{{ f[1] }}{% endif %}</span>
  </div>
  {%- assign n = n | plus: 1 -%}{%- if n >= max -%}{%- break -%}{%- endif -%}
{%- endfor -%}
</div>
{% endtemplate %}
