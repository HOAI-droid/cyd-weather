<div class="view view--{{ size }}">
<style>
  .view:has(> .cw.negativ) { background: #000 !important; }
  .cw.negativ { filter: invert(1); }
  .spk img.plan { position: absolute; left: 50%; top: 50%; width: 800px; height: 480px; margin: -240px 0 0 -400px; image-rendering: pixelated; }
  .spk .titel { position: absolute; right: 0; bottom: 0; background: #fff; border: 2px solid #000; padding: 4px 10px 5px; text-align: right; }
  .spk .titel b { font-size: 19px; display: block; line-height: 1.1; } .spk .titel span { font-size: 12px; }
</style>
<div class="cw spk{% if cf.darstellung == 'negativ' %} negativ{% endif %}">
  {%- if sp_n == 0 -%}<div style="padding:12px;font-size:16px">Schwarzplan: Liste nicht erreichbar.</div>
  {%- else -%}<img class="plan" src="{{ sp.bild }}" alt="">
    {%- if cf.beschriftung != "nein" -%}<div class="titel"><b>{{ sp.n }}</b><span>Schwarzplan · M ≈ {{ sp_massstab }}</span></div>{%- endif -%}
  {%- endif -%}
</div>
</div>
