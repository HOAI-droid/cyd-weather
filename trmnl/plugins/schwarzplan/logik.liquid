{%- comment -%}
  Schwarzplan: Liste aus schwarzplan.json (orte[] mit tag 1–365, m_pro_px). Jeden Tag im Jahr ein Ort:
  der Eintrag mit tag = Tag im Jahr; fehlt er (noch nicht erzeugt), der Reihe nach einer der vorhandenen.
{%- endcomment -%}
{%- assign cf = trmnl.plugin_settings.custom_fields_values -%}
{%- assign sp_orte = orte -%}
{%- assign sp_n = 0 -%}{%- if sp_orte -%}{%- assign sp_n = sp_orte.size -%}{%- endif -%}
{%- comment -%} Tag im Jahr: lokale Tagesnummer minus Tagesnummer des 1. Januar (days_from_civil für y-1, März-Basis) {%- endcomment -%}
{%- assign jy = cw_jahr | minus: 1 -%}{%- assign jera = jy | divided_by: 400 -%}{%- assign jyoe = jera | times: -400 | plus: jy -%}
{%- assign j1 = jyoe | times: 365 -%}{%- assign j2 = jyoe | divided_by: 4 -%}{%- assign j3 = jyoe | divided_by: 100 -%}
{%- assign jan1 = jera | times: 146097 | plus: j1 | plus: j2 | minus: j3 | plus: 306 | minus: 719468 -%}
{%- assign sp_tag = cw_tag0 | minus: jan1 | plus: 1 -%}
{%- if sp_n > 0 -%}
  {%- assign sp = nil -%}
  {%- for o in sp_orte -%}{%- if o.tag == sp_tag -%}{%- assign sp = o -%}{%- break -%}{%- endif -%}{%- endfor -%}
  {%- if sp == nil -%}{%- assign sp_i = sp_tag | minus: 1 | modulo: sp_n -%}{%- assign sp = sp_orte[sp_i] -%}{%- endif -%}
{%- endif -%}
{%- assign sp_mpp = m_pro_px | default: 3.4574 | plus: 0 -%}
{%- comment -%} Maßstabsbalken 500 m; Maßstab am 7,5-Zoll-Display (800 Pixel ≈ 163 mm) {%- endcomment -%}
{%- assign sp_balken = 500 | divided_by: sp_mpp | round -%}
{%- assign sp_mz = sp_mpp | divided_by: 0.204 | times: 2 | round | times: 500 -%}
{%- assign sp_k = sp_mz | divided_by: 1000 | floor -%}{%- assign sp_r = sp_mz | modulo: 1000 | floor -%}
{%- capture sp_massstab -%}1:{{ sp_k }}.{% if sp_r == 0 %}000{% else %}500{% endif %}{%- endcapture -%}
