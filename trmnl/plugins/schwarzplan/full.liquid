<div class="view view--full">
<style>
  .sp { background: #fff; }
  .view:has(> .cw.negativ) { background: #000 !important; }
  .cw.negativ { filter: invert(1); }
  /* Das Bild hat genau Displaygröße und bleibt pixelgenau in der Mitte; der Rand schneidet nur ab */
  .sp img.plan { position: absolute; left: 50%; top: 50%; width: 800px; height: 480px; margin: -240px 0 0 -400px; image-rendering: pixelated; }
  .sp .kasten { position: absolute; background: #fff; border: 2px solid #000; }
  .sp .titel { right: 0; bottom: 0; padding: 7px 14px 8px; text-align: right; min-width: 220px; }
  .sp .titel .k { font-size: 12px; font-weight: 600; letter-spacing: .22em; }
  .sp .titel .n { font-size: 27px; font-weight: 700; line-height: 1.1; }
  .sp .titel .s { font-size: 15px; }
  .sp .titel .m { font-size: 12px; margin-top: 3px; letter-spacing: .04em; }
  .sp .mass { left: 0; bottom: 0; padding: 6px 10px 8px; }
  .sp .mass .bar { height: 7px; display: flex; border: 1.5px solid #000; margin-top: 3px; }
  .sp .mass .bar i { flex: 1; } .sp .mass .bar i:nth-child(odd) { background: #000; }
  .sp .mass .z { font-size: 12px; display: flex; justify-content: space-between; }
  .sp .nord { right: 0; top: 0; width: 44px; height: 58px; display: flex; align-items: center; justify-content: center; }
  .sp .leer { position: absolute; inset: 0; display: flex; flex-direction: column; align-items: center; justify-content: center; font-size: 20px; text-align: center; gap: 8px; }
</style>
<div class="cw sp{% if cf.darstellung == 'negativ' %} negativ{% endif %}">
  {%- if sp_n == 0 -%}
    <div class="leer"><b style="font-size:26px">Schwarzplan</b><span>Die Pläne sind noch nicht erzeugt oder die Liste ist nicht erreichbar.</span><span style="font-size:15px">{{ cf.liste }}</span></div>
  {%- else -%}
    <img class="plan" src="{{ sp.bild }}" alt="">
    {%- if cf.beschriftung != "nein" -%}
    <div class="kasten nord"><svg width="26" height="44" viewBox="0 0 26 44"><path d="M13 2 L22 30 L13 24 L4 30 Z" fill="#000"/><text x="13" y="42" text-anchor="middle" font-size="12" font-weight="700" font-family="Outfit, sans-serif">N</text></svg></div>
    <div class="kasten mass">
      <div class="z"><span>0</span><span>250</span><span>500 m</span></div>
      <div class="bar" style="width: {{ sp_balken }}px"><i></i><i></i><i></i><i></i></div>
    </div>
    <div class="kasten titel">
      <div class="k">SCHWARZPLAN</div>
      <div class="n">{{ sp.n }}</div>
      {%- if sp.sub != blank -%}<div class="s">{{ sp.sub }}</div>{%- endif -%}
      <div class="m">M ≈ {{ sp_massstab }} · Gebäude © OpenStreetMap</div>
    </div>
    {%- endif -%}
  {%- endif -%}
</div>
</div>
